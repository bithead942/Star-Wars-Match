{
  "name": "star-wars-match",
  "version": "1.0.0",
  "description": "Star Wars Match - a full screen touch memory game for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.example.star-wars-match",
    "productName": "Star Wars Match",
    "icon": "img/Star Wars Match Icon.ico",
    "win": {
      "target": "portable",
      "icon": "img/Star Wars Match Icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "main.js",
      "LICENSE",
      "img/**/*"
    ]
  },
  "keywords": [
    "star-wars",
    "memory",
    "game",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  }
}
